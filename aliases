alias ls='eza -G --icons=always --group-directories-first'
alias la='eza -a --icons=always --group-directories-first'
alias ll='eza -l --icons=always --group-directories-first'
alias lll='eza -la --icons=always --group-directories-first'

alias vis="sudo vi"
alias ping="ping -c3"
alias ctl="sudo systemctl"
alias mkdir='mkdir -p'
alias h='history'
alias hl='history | less'
alias hs='history | grep'
alias hsi='history | grep -i'
alias j='jobs -l'
alias which='type -a'
alias ..='cd ..'
alias du='du -kh'    # Makes a more readable output.
alias df='df -kTh'
alias suod='sudo'    # personal issue
alias fuk='sudo $(history -p !!)'

# Alias to create a tmux session with the current folder name if it does not exist
alias tn='tmux new-session -A -s $(basename "$PWD")'
alias ta='tmux a'

