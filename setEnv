#!/bin/bash
# Source custom functions
# DOTFILES_DIR is exported by install.sh (or set here as a fallback when
# setEnv is sourced directly from an interactive shell).
: "${DOTFILES_DIR:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)}"

source "$DOTFILES_DIR/functions"

export DOTFILES_FOLDER="${HOME}/.config/dotfiles"
export DEFAULT_SHELL='zsh'

SYSTEM_INFO="$(get_os)-$(get_arch)"
export SYSTEM_INFO
