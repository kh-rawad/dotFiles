# RomM Helm secret values (example only)
# Copy this file to .env and replace placeholders with real values.

SECRETS_DB_PASSWORD=change_me_db_password
SECRETS_DB_ROOT_PASSWORD=change_me_db_root_password
SECRETS_ROMM_AUTH_SECRET_KEY=replace_with_64_hex_chars

ROMM_SCREENSCRAPER_USER=your_screenscraper_username
ROMM_SCREENSCRAPER_PASSWORD=your_screenscraper_password
ROMM_RETROACHIEVEMENTS_API_KEY=your_retroachievements_api_key
ROMM_STEAMGRIDDB_API_KEY=your_steamgriddb_api_key

ROMM_IGDB_CLIENT_ID=your_igdb_client_id
ROMM_IGDB_CLIENT_SECRET=your_igdb_client_secret

# Example usage:
# set -a && source .env && set +a
# helm upgrade --install romm ./romm/helm \
#   --namespace romm --create-namespace \
#   --set secrets.dbPassword="$SECRETS_DB_PASSWORD" \
#   --set secrets.dbRootPassword="$SECRETS_DB_ROOT_PASSWORD" \
#   --set secrets.rommAuthSecretKey="$SECRETS_ROMM_AUTH_SECRET_KEY" \
#   --set romm.env.screenscraper.user="$ROMM_SCREENSCRAPER_USER" \
#   --set romm.env.screenscraper.password="$ROMM_SCREENSCRAPER_PASSWORD" \
#   --set romm.env.retroachievements.apiKey="$ROMM_RETROACHIEVEMENTS_API_KEY" \
#   --set romm.env.steamgriddb.apiKey="$ROMM_STEAMGRIDDB_API_KEY" \
#   --set romm.env.igdb.clientId="$ROMM_IGDB_CLIENT_ID" \
#   --set romm.env.igdb.clientSecret="$ROMM_IGDB_CLIENT_SECRET"
